{
  "expo": {
    "name": "OmniSaver - All Video Downloader",
    "slug": "media-downloader",
    "version": "1.0.13",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "OmniSaver needs access to save downloaded videos directly to your Photos library.",
        "NSPhotoLibraryAddUsageDescription": "OmniSaver needs permission to save videos to your Photos album."
      }
    },
    "android": {
      "package": "com.omnisaver.downloader",
      "adaptiveIcon": {
        "backgroundColor": "#0B0E14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.WAKE_LOCK",
        "android.permission.RUN_USER_INITIATED_JOBS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "predictiveBackGestureEnabled": false,
      "versionCode": 10013
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow OmniSaver to access your photos to save videos.",
          "savePhotosPermission": "Allow OmniSaver to save videos to your photo library."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#FF5E3A",
          "defaultChannel": "downloads-complete"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ]
          }
        }
      ],
      "@kesha-antonov/react-native-background-downloader"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f749bbeb-ae24-42a4-82f3-309ff57a8f69"
      }
    }
  }
}
